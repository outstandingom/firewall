# ============================================================
# Adaptive Web Observability — Environment Variables
# Copy this file to .env and fill in values
# ============================================================

# Supabase
SUPABASE_URL=https://hkigsjwppfbtkuqhaxsp.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# API Server
API_PORT=3001
API_HOST=0.0.0.0
API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication
JWT_SECRET=change-this-to-a-very-long-random-string-at-least-32-chars
JWT_EXPIRY=7d
BCRYPT_ROUNDS=12

# Redis (optional for local dev — falls back to in-memory)
REDIS_URL=redis://localhost:6379

# Worker
WORKER_CONCURRENCY=4
AGGREGATION_INTERVAL_MS=60000
SESSION_TIMEOUT_MS=1800000
BASELINE_INTERVAL_MS=300000

# Rate Limiting
RATE_LIMIT_EVENTS_PER_MIN=1000
RATE_LIMIT_API_PER_MIN=100

# SDK
SDK_ENDPOINT=http://localhost:3001
SDK_BATCH_SIZE=10
SDK_FLUSH_INTERVAL_MS=5000

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@observability.local

# Node Environment
NODE_ENV=development
LOG_LEVEL=debug
